# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit it. Keep this file's values BLANK.

# console.cloud.google.com — enable "YouTube Data API v3", then create an API key.
# The key must not be API-restricted, or every request returns 403.
YOUTUBE_API_KEY=



# Who writes the report: groq or ollama or gemini or deepseek or anthropic
#
# Only the WRITTEN REPORT needs a model. The score, checklist, and chart come
# from the YouTube API alone and work with no provider configured at all.
LLM_PROVIDER=gemini



# ollama needs NO KEY — it runs the model on your own machine, so it's free
# and has no request limit. It can't be used on Vercel, though: nothing is
# listening on localhost there.
#   1. install from ollama.com
#   2. ollama pull llama3.1:8b
# Both settings below are optional; the defaults are what's shown.
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434


#For the keys you need to do just one of the following:


# console.groq.com — FREE, no card, ~1000 reports/day, and it works when
# deployed. Best default if you're putting this online. Keys look like gsk_...
GROQ_API_KEY=

# aistudio.google.com/apikey — free tier, but only ~20 reports/day.
# Keys look like AIza... or AQ.Ab8...
GEMINI_API_KEY=

# platform.deepseek.com — very cheap. Keys look like sk-...
DEEPSEEK_API_KEY=

# console.anthropic.com/settings/keys — best prose. Keys look like sk-ant-...
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------- tracking --
#
# Only the daily snapshot job needs these. Leave them blank and everything else
# works; /api/cron/refresh just returns 503.
#
# NOTE: these are server-side only. The frontend's Supabase keys live in
# frontend/.env and are a different, public pair — don't mix them up.

# Supabase → Project Settings → Data API → Project URL. No trailing /rest/v1.
# Also required for the signed-out limits: without it the server cannot verify
# tokens, so every caller reads as anonymous and signed-in users get the free
# tier. See api/authz.py.
SUPABASE_URL=

# Supabase → Project Settings → API Keys → anon / publishable. Public, and the
# same value the browser uses. Used only as the `apikey` header when asking
# Supabase to validate a user's token.
SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → service_role. THIS KEY BYPASSES ROW
# LEVEL SECURITY — it can read and write every user's rows. It must never be
# given a VITE_ prefix, committed, or sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vercel Cron sends it as `Authorization: Bearer <value>`. Without it the
# refresh endpoint refuses to run, because that route writes to the database
# with RLS switched off.
CRON_SECRET=
