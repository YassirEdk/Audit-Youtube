# Copy this file to .env in this same folder, fill in the anon key, then
# restart the dev server — Vite only reads env files at startup.
#
# Anything prefixed VITE_ is inlined into the JavaScript bundle and is public.
# That is correct for both values below, and the reason the service_role key
# must never be put here: it bypasses row-level security.

# Supabase → Project Settings → Data API → Project URL.
# Note this is the project root, not the /rest/v1/ endpoint.
VITE_SUPABASE_URL=https://bglngqpgotrzyiyreulh.supabase.co

# Supabase → Project Settings → API Keys → anon / public. Starts with eyJ...
VITE_SUPABASE_ANON_KEY=
